# Sentry do projeto resenhacs-web. Sem a variável o site funciona (no-op).
# Vercel: projeto resenha (Root Directory site/client). Acesso no código é estático
# (import.meta.env.VITE_SENTRY_DSN) — não ler por colchetes.
VITE_SENTRY_DSN=
# Opcional. O build na Vercel preenche sozinho a partir de VERCEL_ENV
# (production→producao, preview→homologacao).
VITE_SENTRY_ENVIRONMENT=
# Opcional. O build usa VERCEL_GIT_COMMIT_SHA quando esta variável está vazia.
VITE_SENTRY_RELEASE=
# O Coletor lê SENTRY_RELEASE (sem prefixo VITE_). Documentada também em
# coletor/.env.example e site/server/.env.example. O browser não usa esta linha.
SENTRY_RELEASE=

# PostHog do projeto resenhacs (EU). Sem a chave, não há cookie nem identify.
# Contagem anônima usa persistence memory; identify só com o steamId, depois do login.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Source maps — só no build da Vercel (projeto resenha), nunca no CI nem no bundle do browser.
# O plugin só roda se SENTRY_AUTH_TOKEN e SENTRY_ORG existirem. Sem eles o build passa.
# Vercel: projeto resenha. SENTRY_PROJECT=resenhacs-web.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=resenhacs-web

# Contato do controlador mostrado em /privacidade (LGPD). Público por natureza (vai no
# bundle). Sem ele a página orienta a falar com o admin do grupo.
VITE_CONTATO_PRIVACIDADE=

# Origem https do backend de staging. O vercel.mjs lê isto no build do projeto
# resenha, só quando VERCEL_ENV não é production. Sem a variável, /api responde 503
# e o preview não grava no banco de produção. Caminho na URL é ignorado.
# Trocar o valor exige um deploy novo (entra na config gerada no build).
PREVIEW_API_URL=
