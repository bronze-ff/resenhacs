# Variáveis do Coletor. No GitHub Actions cada uma vem do secret de mesmo nome
# (repositório bronze-ff/resenhacs → Settings → Secrets → Actions). Local: copie para
# .env (git-ignored) e preencha. Nunca commitar valores.

# Postgres do Supabase (Session Pooler, IPv4). Obrigatória em todo comando que toca o banco.
DATABASE_URL=
# Steam Web API (https://steamcommunity.com/dev/apikey). discover, avatares e FACEIT.
STEAM_API_KEY=
# FACEIT Data API (sincronizar-faceit). Vazio = o passo FACEIT pula.
FACEIT_API_KEY=

# Cloudflare R2 (S3-compatível): Demo, Replay 2D, staging de upload e vídeo de montagem.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Vazio = resenha-demos.
R2_BUCKET=

# Conta-bot Steam que o fetch usa (via bot/src/resolve.js) para pegar o link do .dem
# no Game Coordinator. accountName (nome de usuário), não o e-mail. Rodando local sem
# estas duas, o fetch lê de bot/.env.
STEAM_BOT_USER=
STEAM_BOT_PASS=

# Sentry do projeto resenhacs-coletor (sentry-sdk + Crons). Sem DSN o Coletor segue no-op.
# No GitHub Actions o valor é o secret SENTRY_DSN do repositório bronze-ff/resenhacs.
# SENTRY_ENVIRONMENT=producao é definido no job sincroniza de coletor.yml (não é secret).
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
# Opcional. No Actions o release é GITHUB_SHA. Fora dele, preencha aqui.
SENTRY_RELEASE=

# Discord do grupo (opcional). Webhook do canal: embed com mapa, placar, resultado do
# grupo e MVP quando uma Partida termina de ser ingerida. Vazio = não posta nada.
# No GitHub Actions é o secret DISCORD_WEBHOOK_URL. Nunca commitar o valor (tem token).
DISCORD_WEBHOOK_URL=
# Base do link "abrir Partida" no embed: a origem do client, não a da API
# (ex.: https://resenha-phi.vercel.app). Vazio = sem link.
APP_URL=

# DEMO-SLAP (opcional). Usada só por `juntar-clipes`, que junta os trechos de uma
# montagem da aba Clipes num vídeo único no R2 (precisa de ffmpeg no PATH). Vazio = no-op.
# No GitHub Actions é o secret DEMOSLAP_API_KEY. Mesma chave do site/server.
DEMOSLAP_API_KEY=
